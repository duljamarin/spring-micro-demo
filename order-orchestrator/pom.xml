<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.demo</groupId>
        <artifactId>spring-micro-demo</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>order-orchestrator</artifactId>
    <name>order-orchestrator</name>
    <description>Saga orchestrator: coordinates product-service, order-service and payment-service to place an order, with explicit compensations on failure</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <!-- Feign's default client (java.net.HttpURLConnection) can't send
                 PATCH requests - HttpURLConnection hardcodes the allowed
                 method list and PATCH isn't in it, so confirmOrder/failOrder
                 fail with "Invalid HTTP method: PATCH". Apache HttpClient 5
                 has no such restriction.

                 This was feign-okhttp until Spring Cloud OpenFeign 5.x, which
                 dropped OkHttp support outright: only HttpClient5 and
                 Http2Client remain. The failure mode on upgrade is nasty -
                 the OkHttp property stops being bound, Feign silently falls
                 back to HttpURLConnection, and the saga breaks at its
                 confirm step rather than at startup. -->
            <groupId>io.github.openfeign</groupId>
            <artifactId>feign-hc5</artifactId>
        </dependency>
        <dependency>
            <!-- Boot-generation-specific: see resilience4j.version in the
                 parent pom for why this is -spring-boot4, not -spring-boot3. -->
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
        </dependency>
        <dependency>
            <!-- Spring Boot 4 dropped spring-boot-starter-aop. spring-aop
                 itself still arrives with spring-context, but resilience4j's
                 @CircuitBreaker/@Retry are AspectJ-annotated, so the weaver
                 has to be asked for explicitly now. Version comes from the
                 Boot BOM, which still manages aspectj. -->
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
